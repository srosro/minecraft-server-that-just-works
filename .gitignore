# Minecraft's pre-upgrade level.dat backups
*.dat_old

# Floodgate's shared secret. Anyone holding it can forge a Bedrock login as
# any username, including an op -- Floodgate players bypass Mojang auth by
# design. Regenerated on first start; must never be committed.
/server/plugins/floodgate/key.pem
