# Regenerated by Paper on every start — version-specific, never hand-edited.
/server/versions/
/server/libraries/
/server/cache/
/server/logs/
/server/usercache.json
/server/.console_history

# Same, at the repo root, for a host that ran the pre-server/ layout. Enumerated
# rather than unanchored: a bare `cache/` would also shadow the tracked
# server/plugins/Geyser-Spigot/cache/ and server/plugins/.paper-remapped/libraries/,
# hiding plugin state a version bump regenerates from `git status`.
/versions/
/libraries/
/cache/
/logs/
/usercache.json
/.console_history

# Minecraft's pre-upgrade level.dat backups
*.dat_old

# Floodgate's shared secret. Anyone holding it can forge a Bedrock login as any
# username, including an op -- Floodgate players bypass Mojang auth by design.
# Regenerated on first start; must never be committed. Matched at any depth so a
# stale copy from the old layout can't be added from the repo root.
**/floodgate/key.pem
